# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE and editors
.vscode/
.idea/
.vs/
*.swp
*.swo
*.code-workspace
.cursor/
.claude/

# Agent context & AI assistants
.agents/
.agent/
opencode.json

# Testing and coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.cache/

# Environment variables & secrets
.env
.env.*
*.pem
*.key

# Temporary and log files
*.tmp
*.bak
*.log

# Windows OS artifacts
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Arduino build artifacts
*.hex
*.elf
*.eep

# Runtime output (ignore everything generated in output/ except .gitkeep)
output/*
!output/.gitkeep

# Heavy game map assets (downloaded from GitHub Releases via tools/download_map.py)
data/maps/*
!data/maps/.gitkeep
!data/maps/catalog.json
!data/maps/*_gray.txt
